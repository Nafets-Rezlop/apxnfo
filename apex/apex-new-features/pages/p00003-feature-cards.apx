page 3 (
    name: Feature Cards
    alias: FEATURE-CARDS
    title: Feature Cards
    pageGroup: @overview
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirement 860. Each card shows title, category, English summary and release.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region feature-card-facets (
        name: Feature Card Facets
        type: facetedSearch
        source {
            filteredRegion: @feature-card-gallery
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Provides release and category facets that filter the feature cards.
        }
        settings {
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
        }

        facet P3_F_FEAT_CATG_ID (
            type: checkboxGroup
            label {
                label: Category
            }
            lov {
                type: sharedComponent
                lov: @lov-categories
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 6
            }
            source {
                databaseColumn: FEAT_CATG_ID
                dataType: number
            }
        )

        facet P3_F_FEAT_REL_ID (
            type: checkboxGroup
            label {
                label: Release
            }
            lov {
                type: sharedComponent
                lov: @lov-releases
            }
            layout {
                sequence: 10
            }
            listEntries {
                maxDisplayedEntries: 6
            }
            source {
                databaseColumn: FEAT_REL_ID
                dataType: number
            }
        )

        facet P3_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 1
            }
        )

    )

    region feature-card-gallery (
        name: Feature Card Gallery
        type: cards
        source {
            location: localDatabase
            tableName: V_NFO_UI_FEATURES
        }
        orderBy {
            type: staticValue
            orderByClause: REL_VERSION desc, FEAT_TITLE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Shows one card per feature and lets contributors open the feature form from a card button.
        }
        card {
            primaryKeyColumn1: FEAT_ID
        }
        title {
            column: FEAT_TITLE
        }
        subtitle {
            advancedFormatting: true
            htmlExpression: &CATG_NAME_EN.
        }
        body {
            advancedFormatting: true
            htmlExpression: Feature Summary (en): &FEAT_SUMMARY_EN.
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression: Release: &REL_VERSION.
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: CATG_ICON
            iconPosition: start
        }
        pagination {
            showTotalCount: true
        }

        action action-button-1 (
            label: Edit
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 5
                    items: {
                        P5_FEAT_ID: \&FEAT_ID.\
                    }
                }
            }
            security {
                authorizationScheme: @administrator-or-contributor
            }
        )

    )

    button create-feature (
        buttonName: CREATE-FEATURE
        label: Create Feature
        layout {
            sequence: 1
            region: @feature-card-gallery
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

    dynamicAction dialog-refresh-feature-card-gallery (
        name: Refresh on dialog close Feature Card Gallery
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @feature-card-gallery
        }

        action refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @feature-card-gallery
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

