page 3 (
    name: Feature Cards
    alias: FEATURE-CARDS
    title: Feature Cards
    pageGroup: @overview
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* Release Video and Video Chapter buttons only when a link exists */
            a[data-video=""],
            a[data-chapter=""] {
                display: none;
            }
            ```
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirement 860. Each card shows title, category, English summary and release, with buttons to the Oracle documentation, the main release video and the video chapter that presents the feature.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region feature-card-facets (
        name: Feature Card Facets
        type: facetedSearch
        source {
            filteredRegion: @feature-card-gallery
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Provides release and category facets that filter the feature cards.
        }
        settings {
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
        }

        facet P3_F_FEAT_CATG_ID (
            type: checkboxGroup
            label {
                label: Category
            }
            lov {
                type: sharedComponent
                lov: @lov-categories
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 6
            }
            source {
                databaseColumn: FEAT_CATG_ID
                dataType: number
            }
        )

        facet P3_F_FEAT_REL_ID (
            type: checkboxGroup
            label {
                label: Release
            }
            lov {
                type: sharedComponent
                lov: @lov-releases
            }
            layout {
                sequence: 10
            }
            listEntries {
                maxDisplayedEntries: 6
            }
            source {
                databaseColumn: FEAT_REL_ID
                dataType: number
            }
        )

        facet P3_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 1
            }
        )

    )

    region feature-card-gallery (
        name: Feature Card Gallery
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.*
                     , ( select max(v.VID_YOUTUBE_URL)
                           from V_NFO_UI_RELEASE_VIDEOS v
                          where v.VID_REL_ID = f.FEAT_REL_ID
                            and v.VID_IS_MAIN = 'Y' ) as MAIN_VIDEO_URL
                from V_NFO_UI_FEATURES f
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: REL_VERSION desc, FEAT_TITLE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Shows one card per feature and lets contributors open the feature form from a card button.
        }
        card {
            primaryKeyColumn1: FEAT_ID
        }
        title {
            column: FEAT_TITLE
        }
        subtitle {
            advancedFormatting: true
            htmlExpression: "{case P3_LANG/}{when de/}&CATG_NAME_DE.{otherwise/}&CATG_NAME_EN.{endcase/}"
        }
        body {
            advancedFormatting: true
            htmlExpression: "{case P3_LANG/}{when de/}&FEAT_SUMMARY_DE.{otherwise/}&FEAT_SUMMARY_EN.{endcase/}"
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression: Release: &REL_VERSION.
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: CATG_ICON
            iconCssClasses: fa
            iconPosition: start
        }
        pagination {
            showTotalCount: true
        }

        action oracle-doc (
            label: Oracle Doc
            appearance {
                displayType: textWithIcon
                icon: fa-external-link
            }
            layout {
                sequence: 5
            }
            behavior {
                type: redirectUrl
                targetUrl: &FEAT_LINK_FEATURE_ORACLE_DOC.
                linkAttributes: target="_blank" rel="noopener"
            }
        )

        action release-video (
            label: Release Video
            appearance {
                displayType: textWithIcon
                icon: fa-youtube-play
            }
            layout {
                sequence: 7
            }
            behavior {
                type: redirectUrl
                targetUrl: &MAIN_VIDEO_URL.
                linkAttributes: target="_blank" rel="noopener" data-video="&MAIN_VIDEO_URL."
            }
        )

        action video-chapter (
            label: Video Chapter
            appearance {
                displayType: textWithIcon
                icon: fa-play-circle
            }
            layout {
                sequence: 8
            }
            behavior {
                type: redirectUrl
                targetUrl: &CHAP_LINK_URL.
                linkAttributes: target="_blank" rel="noopener" data-chapter="&CHAP_LINK_URL."
            }
        )

        action action-button-1 (
            label: Edit
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 5
                    items: {
                        P5_FEAT_ID: \&FEAT_ID.\
                    }
                }
            }
            security {
                authorizationScheme: @administrator-or-contributor
            }
        )

    )

    pageItem P3_LANG (
        type: hidden
        layout {
            sequence: 10
            region: @button-bar
            slot: regionBody
        }
        source {
            type: item
            item: AI_LANG
            used: always
        }
        comments {
            comments: Copy of the application item AI_LANG. The card templates are rendered in the browser and can only read page items, so the template directives use this item.
        }
    )

    button create-feature (
        buttonName: CREATE-FEATURE
        label: Create Feature
        layout {
            sequence: 1
            region: @feature-card-gallery
            slot: sortOrder
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

    dynamicAction dialog-refresh-feature-card-gallery (
        name: Refresh on dialog close Feature Card Gallery
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @feature-card-gallery
        }

        action refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @feature-card-gallery
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

