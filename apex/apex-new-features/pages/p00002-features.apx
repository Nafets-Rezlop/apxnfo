page 2 (
    name: Features
    alias: FEATURES
    title: Features
    pageGroup: @overview
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 800 and 810. Contributors open the feature form from each row, administrators and contributors can also create features.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region feature-facets (
        name: Feature Facets
        type: facetedSearch
        source {
            filteredRegion: @feature-list
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Provides release and category facets that filter the feature list.
        }
        settings {
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
        }

        facet P2_F_FEAT_CATG_ID (
            type: checkboxGroup
            label {
                label: Category
            }
            lov {
                type: sharedComponent
                lov: @lov-categories
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 6
            }
            source {
                databaseColumn: FEAT_CATG_ID
                dataType: number
            }
        )

        facet P2_F_FEAT_REL_ID (
            type: checkboxGroup
            label {
                label: Release
            }
            lov {
                type: sharedComponent
                lov: @lov-releases
            }
            layout {
                sequence: 10
            }
            listEntries {
                maxDisplayedEntries: 6
            }
            source {
                databaseColumn: FEAT_REL_ID
                dataType: number
            }
        )

        facet P2_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 1
            }
        )

    )

    region feature-list (
        name: Feature List
        type: classicReport
        source {
            location: localDatabase
            tableName: V_NFO_UI_FEATURES
        }
        orderBy {
            type: staticValue
            orderByClause: REL_VERSION desc, FEAT_TITLE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Tabular feature list with title, German summary and Oracle documentation link, filtered by the facets.
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CATG_NAME_EN (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 60
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: link
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 5
                    items: {
                        P5_FEAT_ID: \#FEAT_ID#\
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
        )

        column FEAT_CATG_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column FEAT_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column FEAT_LINK_FEATURE_ORACLE_DOC (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Link to Oracle Doc
            }
            layout {
                sequence: 90
            }
        )

        column FEAT_REL_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column FEAT_SUMMARY_DE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Feature Summary (de)
            }
            layout {
                sequence: 80
            }
        )

        column FEAT_SUMMARY_EN (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Feature Summary (en)
            }
            layout {
                sequence: 85
            }
        )

        column FEAT_TITLE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Feature
            }
            layout {
                sequence: 70
            }
        )

        column REL_VERSION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Release
            }
            layout {
                sequence: 50
            }
        )

    )

    button create-feature (
        buttonName: CREATE-FEATURE
        label: Create Feature
        layout {
            sequence: 1
            region: @feature-list
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

    dynamicAction dialog-refresh-feature-list (
        name: Refresh on dialog close Feature List
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @feature-list
        }

        action refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @feature-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

