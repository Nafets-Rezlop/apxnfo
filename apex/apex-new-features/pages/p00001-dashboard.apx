page 1 (
    name: Dashboard
    alias: DASHBOARD
    title: Dashboard
    pageGroup: @overview
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 200 to 230, 830 and 840. Feature counts per release and category are on the Feature Statistics page. Contributors maintain videos and chapters from this page. The embedded player for the selected video is added manually after import.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region chapters-of-selected-release (
        name: Chapters of Selected Release
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.CHAP_ID as CHAP_ID
                     , v.VID_TITLE as VID_TITLE
                     , c.CHAP_START_SECONDS as CHAP_START_SECONDS
                     , c.CHAP_TITLE as CHAP_TITLE
                     , c.CHAP_LINK_URL as CHAP_LINK_URL
                from V_NFO_UI_VIDEO_CHAPTERS c
                join V_NFO_UI_RELEASE_VIDEOS v
                    on v.VID_ID = c.CHAP_VID_ID
                where v.VID_REL_ID = to_number(:P1_REL_ID)
                order by v.VID_IS_MAIN desc
                       , v.VID_TITLE
                       , c.CHAP_START_SECONDS
                ```
            pageItemsToSubmit: P1_REL_ID
        }
        layout {
            sequence: 30
            slot: body
            column: 5
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Child report of the video chapters of the selected release. The no data found message is set to No chapters found after import, as required by requirement 230.
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CHAP_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column CHAP_LINK_URL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Chapter Link
            }
            layout {
                sequence: 60
            }
        )

        column CHAP_START_SECONDS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Start Seconds
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G990
            }
        )

        column CHAP_TITLE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Chapter
            }
            layout {
                sequence: 50
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: link
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 11
                    items: {
                        P11_CHAP_ID: \#CHAP_ID#\
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
        )

        column VID_TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Video Title
            }
            layout {
                sequence: 30
            }
        )

    )

    region filter-release-selector (
        name: Release Selector
        type: smartFilters
        source {
            filteredRegion: @release-selector
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
            ]
            renderComponents: belowContent
        }
        advanced {
            htmlDomId: filter-release-selector
        }
        comments {
            comments: Added by generator
        }
        settings {
            maxSuggestionChips: 0
        }

        filter P1_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 1
            }
        )

    )

    region release-selector (
        name: Release Selector
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            tableName: V_NFO_UI_RELEASES
        }
        orderBy {
            type: staticValue
            orderByClause: REL_VERSION desc
        }
        layout {
            sequence: 10
            parentRegion: @filter-release-selector
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noUI
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        accessibility {
            landmarkType: region
        }
        comments {
            comments: Parent list of releases that sets the release context for the video and chapter regions.
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &REL_VERSION.
            description: New Features Page: &REL_NEW_FEATURES_URL.
            miscellaneous: New Features PDF: &REL_PDF_URL.
        }

        column REL_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: REL_ID
                dataType: number
                primaryKey: true
            }
        )

        column REL_NEW_FEATURES_URL (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: REL_NEW_FEATURES_URL
                dataType: varchar2
            }
        )

        column REL_PDF_URL (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: REL_PDF_URL
                dataType: varchar2
            }
        )

        column REL_VERSION (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: REL_VERSION
                dataType: varchar2
            }
        )

        action action (
            position: fullRowLink
            layout {
                sequence: 5
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

        action action-fullrowlink-1 (
            position: fullRowLink
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 1
                    items: {
                        P1_REL_ID: \&REL_ID.\
                    }
                }
            }
        )

    )

    region videos-of-selected-release (
        name: Videos of Selected Release
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.VID_ID as VID_ID
                     , v.VID_TITLE as VID_TITLE
                     , v.VID_YOUTUBE_URL as VID_YOUTUBE_URL
                     , v.VID_IS_MAIN as VID_IS_MAIN
                     , v.VID_FETCHED_AT as VID_FETCHED_AT
                from V_NFO_UI_RELEASE_VIDEOS v
                where v.VID_REL_ID = to_number(:P1_REL_ID)
                order by v.VID_IS_MAIN desc
                       , v.VID_TITLE
                ```
            pageItemsToSubmit: P1_REL_ID
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            column: 5
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Child report of the YouTube videos of the selected release with the main video flag and edit navigation for contributors.
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DERIVED$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: link
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 10
                    items: {
                        P10_VID_ID: \#VID_ID#\
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
        )

        column VID_FETCHED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Description Fetched At
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: YYYY-MM-DD HH24:MI
            }
        )

        column VID_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column VID_IS_MAIN (
            reportColumnQueryId: 5
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Main Video
            }
            lov {
                type: sharedComponent
                lov: @lov-yes-no
            }
            layout {
                sequence: 50
            }
        )

        column VID_TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Video Title
            }
            layout {
                sequence: 30
            }
        )

        column VID_YOUTUBE_URL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: YouTube Link
            }
            layout {
                sequence: 40
            }
        )

    )

    pageItem P1_REL_ID (
        type: hidden
        layout {
            sequence: 10
            region: @release-selector
            slot: regionBody
        }
    )

    button create-video (
        buttonName: CREATE-VIDEO
        label: Create Video
        layout {
            sequence: 1
            region: @videos-of-selected-release
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

    dynamicAction dialog-closed-parent-action (
        name: Parent Action Dialog Closed
        execution {
            sequence: 50
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @release-selector
        }

        action refresh-2-dialog-closed-parent-action-videos-of-selected-release (
            name: Refresh Videos of Selected Release
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @videos-of-selected-release
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-3-dialog-closed-parent-action-chapters-of-selected-release (
            name: Refresh Chapters of Selected Release
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @chapters-of-selected-release
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-parent-region-action (
            name: Refresh Parent Region
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @release-selector
            }
            execution {
                sequence: 5
                fireOnInit: false
            }
        )

        action select-parent (
            name: Select Parent
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                                    if ($v('P1_REL_ID') !== '') {
                                    setTimeout(function(){
                                        $('.t-ContentRow-item[data-id=' + $v('P1_REL_ID') + ']').click();
                                    }, 2000);
                                    }
                                    
                    ```
            }
            execution {
                sequence: 6
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-refresh-chapters-of-selected-release (
        name: Refresh on dialog close Chapters of Selected Release
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @chapters-of-selected-release
        }

        action refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @chapters-of-selected-release
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-refresh-videos-of-selected-release (
        name: Refresh on dialog close Videos of Selected Release
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @videos-of-selected-release
        }

        action refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @videos-of-selected-release
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction parent-row-selected (
        name: Parent Row Selected
        execution {
            sequence: 20
            eventScope: dynamic
            staticContainer: #filter-release-selector
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .t-ContentRow-item
        }

        action native-add-class (
            action: addClass
            settings {
                class: is-selected
            }
            affectedElements {
                selectionType: triggeringElement
            }
            execution {
                sequence: 7
                fireOnInit: false
            }
        )

        action native-remove-class (
            action: removeClass
            settings {
                class: is-selected
            }
            affectedElements {
                selectionType: javaScriptExpression
                javaScriptExpression: $('.t-ContentRow-item')
            }
            execution {
                sequence: 6
            }
        )

        action refresh-2-parent-row-selected-videos-of-selected-release (
            name: Refresh Videos of Selected Release
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @videos-of-selected-release
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-3-parent-row-selected-chapters-of-selected-release (
            name: Refresh Chapters of Selected Release
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @chapters-of-selected-release
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action set-page-items (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.getAttribute('data-id')
            }
            affectedElements {
                selectionType: items
                items: P1_REL_ID
            }
            execution {
                sequence: 5
                fireOnInit: false
            }
        )

    )

    dynamicAction smart-filter-change (
        name: Smart Filter Change
        execution {
            sequence: 30
        }
        when {
            event: region/smartFilters/facetschange
            selectionType: region
            region: @filter-release-selector
        }

        action clear-page-items (
            name: Clear Page Items
            action: setValue
            affectedElements {
                selectionType: items
                items: P1_REL_ID
            }
            execution {
                sequence: 10
            }
        )

        action refresh-2-smart-filter-change-videos-of-selected-release (
            name: Refresh Videos of Selected Release
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @videos-of-selected-release
            }
            execution {
                sequence: 20
            }
        )

        action refresh-3-smart-filter-change-chapters-of-selected-release (
            name: Refresh Chapters of Selected Release
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @chapters-of-selected-release
            }
            execution {
                sequence: 30
            }
        )

    )

)

