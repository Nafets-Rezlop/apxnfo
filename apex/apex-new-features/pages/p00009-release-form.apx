page 9 (
    name: Release Form
    alias: RELEASE-FORM
    title: Release Form
    pageGroup: @feature-maintenance
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator-or-contributor
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: The save process calls PKG_NFO_REL_DML.MRG and PKG_NFO_REL_DML.DEL with the MD5 checksum item.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region release-form (
        name: Release Form
        type: form
        source {
            location: localDatabase
            tableName: V_NFO_UI_RELEASES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Edits the release version and the Oracle documentation links.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P9_REL_ID (
        type: hidden
        layout {
            sequence: 10
            region: @release-form
            slot: regionBody
        }
        source {
            formRegion: @release-form
            column: REL_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_MD5 (
        type: hidden
        layout {
            sequence: 15
            region: @release-form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        comments {
            comments: MD5 checksum of the release row when the form was loaded. PKG_NFO_REL_DML.MRG compares it to prevent lost updates (requirement 1000).
        }
    )

    pageItem P9_REL_NEW_FEATURES_URL (
        type: textField
        label {
            label: New Features Page
            alignment: right
        }
        layout {
            sequence: 30
            region: @release-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @release-form
            column: REL_NEW_FEATURES_URL
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_REL_PDF_URL (
        type: textField
        label {
            label: New Features PDF
            alignment: right
        }
        layout {
            sequence: 40
            region: @release-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @release-form
            column: REL_PDF_URL
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_REL_VERSION (
        type: textField
        label {
            label: Release
            alignment: right
        }
        layout {
            sequence: 20
            region: @release-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @release-form
            column: REL_VERSION
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_REL_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P9_REL_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_REL_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P9_REL_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25310155672960853
        }
    )

    process initialize-form-release-form (
        name: Initialize form Release Form
        type: formInitialization
        formRegion: @release-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25310222599960853
        }
    )

    process load-checksum (
        name: Load Checksum
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec v_nfo_ui_releases%rowtype;
                   l_md5 varchar2(32767);
                begin
                   l_rec.rel_id := :P9_REL_ID;
                   pkg_nfo_rel_dml.get(l_rec, l_md5);
                   :P9_MD5 := l_md5;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_REL_ID
        }
    )

    process save-release (
        name: Save Release
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec v_nfo_ui_releases%rowtype;
                   l_md5 varchar2(32767) := :P9_MD5;
                   l_dummy varchar2(32767);
                begin
                   l_rec.rel_id := :P9_REL_ID;
                   if :REQUEST = 'DELETE' then
                      pkg_nfo_rel_dml.del(l_rec);
                   else
                      if l_rec.rel_id is not null then
                         pkg_nfo_rel_dml.get(l_rec, l_dummy);
                      end if;
                      l_rec.rel_version          := :P9_REL_VERSION;
                      l_rec.rel_new_features_url := :P9_REL_NEW_FEATURES_URL;
                      l_rec.rel_pdf_url          := :P9_REL_PDF_URL;
                      pkg_nfo_rel_dml.mrg(l_rec, l_md5);
                      :P9_REL_ID := l_rec.rel_id;
                      :P9_MD5    := l_md5;
                   end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
        comments {
            comments: Replaces the generated form DML process (requirement 1000 to 1030). Columns not shown in the form are read with GET first, so MRG does not overwrite them with NULL.
        }
    )

)

