page 8 (
    name: Releases
    alias: RELEASES
    title: Releases
    pageGroup: @feature-maintenance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator-or-contributor
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Supports requirements 420 to 430 and 610 to 650 by maintaining the release master data before a CSV import.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region release-list (
        name: Release List
        type: classicReport
        source {
            location: localDatabase
            tableName: V_NFO_UI_RELEASES
        }
        orderBy {
            type: staticValue
            orderByClause: REL_VERSION desc
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Lists releases newest first and links each row to the release form.
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DERIVED$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: link
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 9
                    items: {
                        P9_REL_ID: \#REL_ID#\
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
        )

        column REL_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column REL_NEW_FEATURES_URL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: New Features Page
            }
            layout {
                sequence: 40
            }
        )

        column REL_PDF_URL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: New Features PDF
            }
            layout {
                sequence: 50
            }
        )

        column REL_VERSION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Release
            }
            layout {
                sequence: 30
            }
        )

    )

    button create-release (
        buttonName: CREATE-RELEASE
        label: Create Release
        layout {
            sequence: 1
            region: @release-list
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
            }
        }
    )

    dynamicAction dialog-refresh-release-list (
        name: Refresh on dialog close Release List
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @release-list
        }

        action refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @release-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

