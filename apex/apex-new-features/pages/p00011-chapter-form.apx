page 11 (
    name: Chapter Form
    alias: CHAPTER-FORM
    title: Chapter Form
    pageGroup: @feature-maintenance
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator-or-contributor
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Chapters are normally extracted automatically from the video description; this form corrects titles and start positions. After import the generated DML process is replaced by PKG_NFO_CHAP_DML.MRG and PKG_NFO_CHAP_DML.DEL.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region chapter-form (
        name: Chapter Form
        type: form
        source {
            location: localDatabase
            tableName: V_NFO_UI_VIDEO_CHAPTERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Edits the video assignment, start position, title and link of a chapter.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P11_CHAP_ID (
        type: hidden
        layout {
            sequence: 10
            region: @chapter-form
            slot: regionBody
        }
        source {
            formRegion: @chapter-form
            column: CHAP_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_CHAP_LINK_URL (
        type: textField
        label {
            label: Chapter Link
            alignment: right
        }
        layout {
            sequence: 50
            region: @chapter-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @chapter-form
            column: CHAP_LINK_URL
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_CHAP_START_SECONDS (
        type: numberField
        label {
            label: Start Seconds
            alignment: right
        }
        layout {
            sequence: 30
            region: @chapter-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @chapter-form
            column: CHAP_START_SECONDS
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_CHAP_TITLE (
        type: textField
        label {
            label: Chapter
            alignment: right
        }
        layout {
            sequence: 40
            region: @chapter-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @chapter-form
            column: CHAP_TITLE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_CHAP_VID_ID (
        type: selectList
        label {
            label: Video
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-release-videos
        }
        layout {
            sequence: 20
            region: @chapter-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @chapter-form
            column: CHAP_VID_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_CHAP_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_CHAP_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_CHAP_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P11_CHAP_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25313650836960862
        }
    )

    process initialize-form-chapter-form (
        name: Initialize form Chapter Form
        type: formInitialization
        formRegion: @chapter-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25313725345960862
        }
    )

    process process-form-chapter-form (
        name: Process form Chapter Form
        type: formAutoRowProcessing
        formRegion: @chapter-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25313861998960862
        }
    )

)

