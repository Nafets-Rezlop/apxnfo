page 6 (
    name: Categories
    alias: CATEGORIES
    title: Categories
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 120 to 170. Opens the category form for rename, create and delete.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region category-list (
        name: Category List
        type: classicReport
        source {
            location: localDatabase
            tableName: V_NFO_UI_CATEGORIES
        }
        orderBy {
            type: staticValue
            orderByClause: CATG_SORT_ORDER, CATG_NAME_EN
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
            ]
        }
        comments {
            comments: Lists categories in sort order and links each row to the category form.
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column CATG_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column CATG_NAME_DE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Name (de)
            }
            layout {
                sequence: 40
            }
        )

        column CATG_NAME_EN (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Name (en)
            }
            layout {
                sequence: 30
            }
        )

        column CATG_SORT_ORDER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Sort Order
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 1
            derivedColumn: Y
            type: link
            heading {
                heading: &nbsp;
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 7
                    items: {
                        P7_CATG_ID: \#CATG_ID#\
                    }
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
        )

    )

    button create-category (
        buttonName: CREATE-CATEGORY
        label: Create Category
        layout {
            sequence: 1
            region: @category-list
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 7
            }
        }
    )

    dynamicAction dialog-refresh-category-list (
        name: Refresh on dialog close Category List
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @category-list
        }

        action refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @category-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

