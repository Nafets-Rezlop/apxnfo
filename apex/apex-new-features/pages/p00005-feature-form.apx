page 5 (
    name: Feature Form
    alias: FEATURE-FORM
    title: Feature Form
    pageGroup: @feature-maintenance
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator-or-contributor
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 310, 850 and 1010. The process Save Feature calls PKG_NFO_FEAT_DML.MRG and PKG_NFO_FEAT_DML.DEL with the MD5 checksum item.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region feature-form (
        name: Feature Form
        type: form
        source {
            location: localDatabase
            tableName: V_NFO_UI_FEATURES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Edits the feature columns of the updatable view V_NFO_UI_FEATURES and returns to the calling page after save or cancel.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P5_FEAT_CATG_ID (
        type: selectList
        label {
            label: Category
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-categories
        }
        layout {
            sequence: 30
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @feature-form
            column: FEAT_CATG_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_CHAP_ID (
        type: selectList
        label {
            label: Video Chapter
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-video-chapters
        }
        layout {
            sequence: 80
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @feature-form
            column: FEAT_CHAP_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @feature-form
            slot: regionBody
        }
        source {
            formRegion: @feature-form
            column: FEAT_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_MD5 (
        type: hidden
        layout {
            sequence: 15
            region: @feature-form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        comments {
            comments: MD5 checksum of the feature row when the form was loaded. PKG_NFO_FEAT_DML.MRG compares it to prevent lost updates (requirement 1000).
        }
    )

    pageItem P5_FEAT_LINK_FEATURE_ORACLE_DOC (
        type: textField
        label {
            label: Link to Oracle Doc
            alignment: right
        }
        layout {
            sequence: 70
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @feature-form
            column: FEAT_LINK_FEATURE_ORACLE_DOC
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_REL_ID (
        type: selectList
        label {
            label: Release
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-releases
        }
        layout {
            sequence: 20
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @feature-form
            column: FEAT_REL_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_SUMMARY_DE (
        type: textarea
        label {
            label: Feature Summary (de)
            alignment: right
        }
        layout {
            sequence: 60
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @feature-form
            column: FEAT_SUMMARY_DE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_SUMMARY_EN (
        type: textarea
        label {
            label: Feature Summary (en)
            alignment: right
        }
        layout {
            sequence: 50
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @feature-form
            column: FEAT_SUMMARY_EN
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_TITLE (
        type: textField
        label {
            label: Feature
            alignment: right
        }
        layout {
            sequence: 40
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @feature-form
            column: FEAT_TITLE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_FEAT_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_FEAT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_FEAT_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P5_FEAT_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25304961624960805
        }
    )

    process initialize-form-feature-form (
        name: Initialize form Feature Form
        type: formInitialization
        formRegion: @feature-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25305075040960806
        }
    )

    process load-checksum (
        name: Load Checksum
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec v_nfo_ui_features%rowtype;
                   l_md5 varchar2(32767);
                begin
                   l_rec.feat_id := :P5_FEAT_ID;
                   pkg_nfo_feat_dml.get(l_rec, l_md5);
                   :P5_MD5 := l_md5;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_FEAT_ID
        }
    )

    process save-feature (
        name: Save Feature
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec v_nfo_ui_features%rowtype;
                   l_md5 varchar2(32767) := :P5_MD5;
                   l_dummy varchar2(32767);
                begin
                   l_rec.feat_id := :P5_FEAT_ID;
                   if :REQUEST = 'DELETE' then
                      pkg_nfo_feat_dml.del(l_rec);
                   else
                      if l_rec.feat_id is not null then
                         pkg_nfo_feat_dml.get(l_rec, l_dummy);
                      end if;
                      -- a chapter chosen in the form is a manual assignment: score empty
                      if nvl(l_rec.feat_chap_id, -1) != nvl(to_number(:P5_FEAT_CHAP_ID), -1) then
                         l_rec.feat_chapter_match_score := null;
                      end if;
                      l_rec.feat_rel_id                  := :P5_FEAT_REL_ID;
                      l_rec.feat_catg_id                 := :P5_FEAT_CATG_ID;
                      l_rec.feat_chap_id                 := :P5_FEAT_CHAP_ID;
                      l_rec.feat_title                   := :P5_FEAT_TITLE;
                      l_rec.feat_summary_de              := :P5_FEAT_SUMMARY_DE;
                      l_rec.feat_summary_en              := :P5_FEAT_SUMMARY_EN;
                      l_rec.feat_link_feature_oracle_doc := :P5_FEAT_LINK_FEATURE_ORACLE_DOC;
                      pkg_nfo_feat_dml.mrg(l_rec, l_md5);
                      :P5_FEAT_ID := l_rec.feat_id;
                      :P5_MD5     := l_md5;
                   end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
        comments {
            comments: Replaces the generated form DML process (requirement 1000 to 1030). Columns not shown in the form, such as FEAT_RAW_TEXT_EN, are read with GET first, so MRG does not overwrite them with NULL. Changing the chapter clears the match score, which marks the assignment as manual for PKG_NFO_CHAPTER_MATCHER.
        }
    )

)

