page 5 (
    name: Feature Form
    alias: FEATURE-FORM
    title: Feature Form
    pageGroup: @feature-maintenance
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator-or-contributor
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 310, 850 and 1010. After import the generated DML process is replaced by calls to PKG_NFO_FEAT_DML.MRG and PKG_NFO_FEAT_DML.DEL with the MD5 checksum item.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region feature-form (
        name: Feature Form
        type: form
        source {
            location: localDatabase
            tableName: V_NFO_UI_FEATURES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Edits the feature columns of the updatable view V_NFO_UI_FEATURES and returns to the calling page after save or cancel.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P5_FEAT_CATG_ID (
        type: selectList
        label {
            label: Category
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-categories
        }
        layout {
            sequence: 30
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @feature-form
            column: FEAT_CATG_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_CHAP_ID (
        type: selectList
        label {
            label: Video Chapter
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-video-chapters
        }
        layout {
            sequence: 80
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @feature-form
            column: FEAT_CHAP_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @feature-form
            slot: regionBody
        }
        source {
            formRegion: @feature-form
            column: FEAT_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_LINK_FEATURE_ORACLE_DOC (
        type: textField
        label {
            label: Link to Oracle Doc
            alignment: right
        }
        layout {
            sequence: 70
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @feature-form
            column: FEAT_LINK_FEATURE_ORACLE_DOC
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_REL_ID (
        type: selectList
        label {
            label: Release
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-releases
        }
        layout {
            sequence: 20
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @feature-form
            column: FEAT_REL_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_SUMMARY_DE (
        type: textarea
        label {
            label: Feature Summary (de)
            alignment: right
        }
        layout {
            sequence: 60
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @feature-form
            column: FEAT_SUMMARY_DE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_SUMMARY_EN (
        type: textarea
        label {
            label: Feature Summary (en)
            alignment: right
        }
        layout {
            sequence: 50
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @feature-form
            column: FEAT_SUMMARY_EN
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_FEAT_TITLE (
        type: textField
        label {
            label: Feature
            alignment: right
        }
        layout {
            sequence: 40
            region: @feature-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @feature-form
            column: FEAT_TITLE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_FEAT_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_FEAT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_FEAT_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P5_FEAT_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25304961624960805
        }
    )

    process initialize-form-feature-form (
        name: Initialize form Feature Form
        type: formInitialization
        formRegion: @feature-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25305075040960806
        }
    )

    process process-form-feature-form (
        name: Process form Feature Form
        type: formAutoRowProcessing
        formRegion: @feature-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25305109194960806
        }
    )

)

