page 10 (
    name: Video Form
    alias: VIDEO-FORM
    title: Video Form
    pageGroup: @feature-maintenance
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator-or-contributor
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 200 to 240. The save process calls PKG_NFO_VID_DML.MRG and PKG_NFO_VID_DML.DEL with the MD5 checksum item and then PKG_NFO_CHAPTER_EXTRACTOR to extract the chapters.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region video-form (
        name: Video Form
        type: form
        source {
            location: localDatabase
            tableName: V_NFO_UI_RELEASE_VIDEOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Edits the release assignment, YouTube link, video key, main video flag and description text of a video.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10_VID_DESCRIPTION (
        type: textarea
        label {
            label: Video Description
            alignment: right
        }
        layout {
            sequence: 70
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @video-form
            column: VID_DESCRIPTION
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_FETCHED_AT (
        type: datePicker
        label {
            label: Description Fetched At
            alignment: right
        }
        layout {
            sequence: 80
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: YYYY-MM-DD HH24:MI
            width: 32
        }
        source {
            formRegion: @video-form
            column: VID_FETCHED_AT
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_ID (
        type: hidden
        layout {
            sequence: 10
            region: @video-form
            slot: regionBody
        }
        source {
            formRegion: @video-form
            column: VID_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_MD5 (
        type: hidden
        layout {
            sequence: 15
            region: @video-form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        comments {
            comments: MD5 checksum of the video row when the form was loaded. PKG_NFO_VID_DML.MRG compares it to prevent lost updates (requirement 1000).
        }
    )

    pageItem P10_VID_IS_MAIN (
        type: selectList
        label {
            label: Main Video
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-yes-no
        }
        layout {
            sequence: 60
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_IS_MAIN
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_REL_ID (
        type: selectList
        label {
            label: Release
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-releases
        }
        layout {
            sequence: 20
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_REL_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_TITLE (
        type: textField
        label {
            label: Video Title
            alignment: right
        }
        layout {
            sequence: 30
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @video-form
            column: VID_TITLE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_YOUTUBE_KEY (
        type: textField
        label {
            label: YouTube Video ID
            alignment: right
        }
        layout {
            sequence: 50
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_YOUTUBE_KEY
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_YOUTUBE_URL (
        type: textField
        label {
            label: YouTube Link
            alignment: right
        }
        layout {
            sequence: 40
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_YOUTUBE_URL
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_VID_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P10_VID_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_VID_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P10_VID_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25312062558960858
        }
    )

    process initialize-form-video-form (
        name: Initialize form Video Form
        type: formInitialization
        formRegion: @video-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25312141935960858
        }
    )

    process load-checksum (
        name: Load Checksum
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec v_nfo_ui_release_videos%rowtype;
                   l_md5 varchar2(32767);
                begin
                   l_rec.vid_id := :P10_VID_ID;
                   pkg_nfo_vid_dml.get(l_rec, l_md5);
                   :P10_MD5 := l_md5;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_VID_ID
        }
    )

    process save-video (
        name: Save Video
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec     v_nfo_ui_release_videos%rowtype;
                   l_md5     varchar2(32767) := :P10_MD5;
                   l_dummy   varchar2(32767);
                   l_count   pls_integer;
                   l_message varchar2(4000);
                begin
                   l_rec.vid_id := :P10_VID_ID;
                   if :REQUEST = 'DELETE' then
                      pkg_nfo_vid_dml.del(l_rec);
                   else
                      if l_rec.vid_id is not null then
                         pkg_nfo_vid_dml.get(l_rec, l_dummy);
                      end if;
                      l_rec.vid_rel_id      := :P10_VID_REL_ID;
                      l_rec.vid_title       := :P10_VID_TITLE;
                      l_rec.vid_youtube_url := :P10_VID_YOUTUBE_URL;
                      l_rec.vid_youtube_key := :P10_VID_YOUTUBE_KEY;
                      l_rec.vid_is_main     := :P10_VID_IS_MAIN;
                      l_rec.vid_description := :P10_VID_DESCRIPTION;
                      l_rec.vid_fetched_at  := to_date(:P10_VID_FETCHED_AT, 'YYYY-MM-DD HH24:MI');
                      pkg_nfo_vid_dml.mrg(l_rec, l_md5);
                      :P10_VID_ID := l_rec.vid_id;
                      :P10_MD5    := l_md5;

                      -- requirement 220: extract the chapters from the saved description
                      if l_rec.vid_description is not null then
                         pkg_nfo_chapter_extractor.extract_video(l_rec.vid_id, l_count, l_message);
                         apex_application.g_print_success_message := l_message;
                      end if;
                   end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
        comments {
            comments: Replaces the generated form DML process (requirement 1000 to 1030) and extracts the video chapters with PKG_NFO_CHAPTER_EXTRACTOR after saving (requirement 220).
        }
    )

)

