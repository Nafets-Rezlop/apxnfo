page 10 (
    name: Video Form
    alias: VIDEO-FORM
    title: Video Form
    pageGroup: @feature-maintenance
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator-or-contributor
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 200 to 240. After import the generated DML process is replaced by PKG_NFO_VID_DML.MRG and PKG_NFO_VID_DML.DEL, and the chapter extraction PKG_NFO_CHAPTER_EXTRACTOR is called after saving a video.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region video-form (
        name: Video Form
        type: form
        source {
            location: localDatabase
            tableName: V_NFO_UI_RELEASE_VIDEOS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Edits the release assignment, YouTube link, video key, main video flag and description text of a video.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10_VID_DESCRIPTION (
        type: textarea
        label {
            label: Video Description
            alignment: right
        }
        layout {
            sequence: 70
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @video-form
            column: VID_DESCRIPTION
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_FETCHED_AT (
        type: datePicker
        label {
            label: Description Fetched At
            alignment: right
        }
        layout {
            sequence: 80
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: YYYY-MM-DD HH24:MI
            width: 32
        }
        source {
            formRegion: @video-form
            column: VID_FETCHED_AT
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_ID (
        type: hidden
        layout {
            sequence: 10
            region: @video-form
            slot: regionBody
        }
        source {
            formRegion: @video-form
            column: VID_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_IS_MAIN (
        type: selectList
        label {
            label: Main Video
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-yes-no
        }
        layout {
            sequence: 60
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_IS_MAIN
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_REL_ID (
        type: selectList
        label {
            label: Release
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @lov-releases
        }
        layout {
            sequence: 20
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_REL_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_TITLE (
        type: textField
        label {
            label: Video Title
            alignment: right
        }
        layout {
            sequence: 30
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @video-form
            column: VID_TITLE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_YOUTUBE_KEY (
        type: textField
        label {
            label: YouTube Video ID
            alignment: right
        }
        layout {
            sequence: 50
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_YOUTUBE_KEY
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_VID_YOUTUBE_URL (
        type: textField
        label {
            label: YouTube Link
            alignment: right
        }
        layout {
            sequence: 40
            region: @video-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @video-form
            column: VID_YOUTUBE_URL
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_VID_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P10_VID_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10_VID_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P10_VID_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25312062558960858
        }
    )

    process initialize-form-video-form (
        name: Initialize form Video Form
        type: formInitialization
        formRegion: @video-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25312141935960858
        }
    )

    process process-form-video-form (
        name: Process form Video Form
        type: formAutoRowProcessing
        formRegion: @video-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25312221279960858
        }
    )

)

