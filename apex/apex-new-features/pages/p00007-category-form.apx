page 7 (
    name: Category Form
    alias: CATEGORY-FORM
    title: Category Form
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administrator
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }
    comments {
        comments: Implements requirements 140 to 170. The save process calls PKG_NFO_CATG_DML.MRG and PKG_NFO_CATG_DML.DEL with the MD5 checksum item, which reject duplicate names and deletion of categories that still have features.
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region category-form (
        name: Category Form
        type: form
        source {
            location: localDatabase
            tableName: V_NFO_UI_CATEGORIES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Region--noBorder
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        comments {
            comments: Edits the German and English category names and the sort order.
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P7_CATG_ID (
        type: hidden
        layout {
            sequence: 10
            region: @category-form
            slot: regionBody
        }
        source {
            formRegion: @category-form
            column: CATG_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P7_MD5 (
        type: hidden
        layout {
            sequence: 15
            region: @category-form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        comments {
            comments: MD5 checksum of the category row when the form was loaded. PKG_NFO_CATG_DML.MRG compares it to prevent lost updates (requirement 1000).
        }
    )

    pageItem P7_CATG_NAME_DE (
        type: textField
        label {
            label: Name (de)
            alignment: right
        }
        layout {
            sequence: 30
            region: @category-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @category-form
            column: CATG_NAME_DE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P7_CATG_NAME_EN (
        type: textField
        label {
            label: Name (en)
            alignment: right
        }
        layout {
            sequence: 20
            region: @category-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @category-form
            column: CATG_NAME_EN
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P7_CATG_SORT_ORDER (
        type: numberField
        label {
            label: Sort Order
            alignment: right
        }
        layout {
            sequence: 40
            region: @category-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @category-form
            column: CATG_SORT_ORDER
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P7_CATG_ICON (
        type: textField
        label {
            label: Icon
            alignment: right
        }
        layout {
            sequence: 50
            region: @category-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @category-form
            column: CATG_ICON
            dataType: varchar2
        }
        default {
            type: static
            staticValue: fa-tag
        }
        help {
            inlineHelpText: Font APEX icon class, for example fa-database.
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 2
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_CATG_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 4
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction cancel-dialog (
            name: Cancel Dialog
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 1
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P7_CATG_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 3
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_CATG_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: P7_CATG_ID
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 25307529142960847
        }
    )

    process initialize-form-category-form (
        name: Initialize form Category Form
        type: formInitialization
        formRegion: @category-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25307693276960847
        }
    )

    process load-checksum (
        name: Load Checksum
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec v_nfo_ui_categories%rowtype;
                   l_md5 varchar2(32767);
                begin
                   l_rec.catg_id := :P7_CATG_ID;
                   pkg_nfo_catg_dml.get(l_rec, l_md5);
                   :P7_MD5 := l_md5;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P7_CATG_ID
        }
    )

    process save-category (
        name: Save Category
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_rec v_nfo_ui_categories%rowtype;
                   l_md5 varchar2(32767) := :P7_MD5;
                   l_dummy varchar2(32767);
                begin
                   l_rec.catg_id := :P7_CATG_ID;
                   if :REQUEST = 'DELETE' then
                      pkg_nfo_catg_dml.del(l_rec);
                   else
                      if l_rec.catg_id is not null then
                         pkg_nfo_catg_dml.get(l_rec, l_dummy);
                      end if;
                      l_rec.catg_name_de    := :P7_CATG_NAME_DE;
                      l_rec.catg_name_en    := :P7_CATG_NAME_EN;
                      l_rec.catg_sort_order := :P7_CATG_SORT_ORDER;
                      l_rec.catg_icon       := :P7_CATG_ICON;
                      pkg_nfo_catg_dml.mrg(l_rec, l_md5);
                      :P7_CATG_ID := l_rec.catg_id;
                      :P7_MD5     := l_md5;
                   end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
        comments {
            comments: Replaces the generated form DML process (requirement 1000 to 1030). Columns not shown in the form are read with GET first, so MRG does not overwrite them with NULL.
        }
    )

)

