list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry categories (
        label: Categories
        icon {
            imageIconCssClasses: fa-tags
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 6
            }
        }
        security {
            authorizationScheme: @administrator
        }
    )

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry feature-cards (
        label: Feature Cards
        icon {
            imageIconCssClasses: fa-th-large
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry feature-statistics (
        label: Feature Statistics
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry features (
        label: Features
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry import-log (
        label: Import Log
        icon {
            imageIconCssClasses: fa-upload
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 12
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

    entry releases (
        label: Releases
        icon {
            imageIconCssClasses: fa-rocket
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 8
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

)

