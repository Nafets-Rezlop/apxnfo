list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry lang-de (
        label: Deutsch
        icon {
            imageIconCssClasses: fa-language
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: &APP_PAGE_ID.
                items: {
                    AI_LANG: de
                }
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :APP_PAGE_ID = 3 and nvl(:AI_LANG, 'en') != 'de'
        }
    )

    entry lang-en (
        label: English
        icon {
            imageIconCssClasses: fa-language
        }
        layout {
            sequence: 6
        }
        link {
            target: {
                page: &APP_PAGE_ID.
                items: {
                    AI_LANG: en
                }
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :APP_PAGE_ID = 3 and :AI_LANG = 'de'
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry categories (
        label: Categories
        icon {
            imageIconCssClasses: fa-tags
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 6
            }
        }
        security {
            authorizationScheme: @administrator
        }
    )

    entry feature-cards (
        label: Feature Cards
        icon {
            imageIconCssClasses: fa-th-large
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry feature-statistics (
        label: Feature Statistics
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry ai-feature-search (
        label: AI Feature Search
        icon {
            imageIconCssClasses: fa-sparkles
        }
        layout {
            sequence: 25
        }
        link {
            target: {
                page: 13
            }
        }
    )

    entry release-videos (
        label: Release Videos
        icon {
            imageIconCssClasses: fa-film
        }
        layout {
            sequence: 35
        }
        link {
            target: {
                page: 14
            }
        }
    )

    entry features (
        label: Features
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry import-log (
        label: Import Log
        icon {
            imageIconCssClasses: fa-upload
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 12
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

    entry releases (
        label: Releases
        icon {
            imageIconCssClasses: fa-rocket
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 8
            }
        }
        security {
            authorizationScheme: @administrator-or-contributor
        }
    )

)

